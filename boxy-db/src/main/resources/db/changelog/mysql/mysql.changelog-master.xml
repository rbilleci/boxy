    <!--
      Changeset 2: Replace sp_events__publish_multi with a single-transaction
      bulk INSERT implementation (v2).  The v1 loop (N procedure calls, N
      transactions) is replaced with a set-based approach: JSON_TABLE expands
      all events in one pass, partition IDs are resolved via a direct JOIN on
      namespaces + topics, and both tables are committed in one transaction.
      Expected speedup: 10-50x for batches of >= 10 events.
      See: sp_events__publish_multi_v2.sql and docs/benchmarks.md.
    -->
    <changeSet id="2" author="richard.billeci" dbms="mysql">
        <sqlFile path="sp/sp_events__publish_multi_v2.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"
                 stripComments="false"/>
    </changeSet>

    <!--
      Changeset 3: Optimise sp_sequence (item #38).
      - Replaces the high_watermark UPDATE (which re-joined the sequences table
        by event_id without an index) with @first_seq + ROW_NUMBER() arithmetic,
        eliminating the unbounded sequences scan entirely.
      - Renames OUT parameter p_has_events -> p_processed_count so callers can
        implement dynamic batch sizing (changeset 4).
      - Adds detailed inline documentation.
    -->
    <changeSet id="3" author="richard.billeci" dbms="mysql">
        <sqlFile path="sp/sp_sequence_v2.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"
                 stripComments="false"/>
    </changeSet>

    <!--
      Changeset 4: Sequencer loop improvements (items #40 and #41).
      - Dynamic batch sizing: doubles working batch (up to 10,000) when a full
        batch is processed, resets to minimum after a partial or empty batch.
        Improves burst recovery without an extra COUNT(*) query.
      - Idle sleep reduced from 10ms to 1ms, improving cold-partition latency.
      Depends on changeset 3 (uses p_processed_count from sp_sequence v2).
    -->
    <changeSet id="4" author="richard.billeci" dbms="mysql">
        <sqlFile path="sp/sp_sequence_loop_v2.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"
                 stripComments="false"/>
    </changeSet>

    <!--
      Changeset 5: Add partition_id index to unprocessed_events (item #42).
      Enables efficient partition-range scans for future partitioned sequencing
      and diagnostic queries. Negligible INSERT overhead (table drains rapidly).
    -->
    <changeSet id="5" author="richard.billeci" dbms="mysql">
        <sqlFile path="sp/unprocessed_events_partition_index.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"
                 stripComments="false"/>
    </changeSet>

    <!--
      Changeset 6: sp_events__poll v2 (items #43-#50).
      - Add IN p_batch_size parameter (item #49), clamped to [1, 10000].
      - Update subscription_topics.active_consumers on each poll (item #44).
      - Compute adaptive polling_probability from subscription stats (item #43):
          p = min(1, 1 / (heartbeat_interval * max(active_consumers, 1)))
      - Retain FORCE INDEX hint with detailed documentation (item #47 evaluation).
      - Retain JSON_CONTAINS filter with evaluation note (item #48).
      - Document SKIP LOCKED evaluation finding (items #45/#46).
      - Document pre-computed cursor count evaluation (item #50).
    -->
    <changeSet id="6" author="richard.billeci" dbms="mysql">
        <sqlFile path="sp/sp_events__poll_v2.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"
