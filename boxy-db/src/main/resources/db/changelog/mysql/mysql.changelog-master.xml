        - sp_subscriptions__delete_v2 (item #77)
        - sp_subscriptions__subscribe_v2   (item #77)
        - sp_subscriptions__unsubscribe_v2 (item #77)
        - sp_topics__delete_v2        (item #78)
        - sp_events__poll_v3          (item #79)
