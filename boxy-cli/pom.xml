<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>mvsm</groupId>
        <artifactId>boxy</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>boxy-cli</artifactId>
    <description>Command-line interface for Boxy — schema management, event publishing, and event listening</description>

    <properties>
        <picocli.version>4.7.6</picocli.version>
        <graalvm.native.plugin.version>0.10.6</graalvm.native.plugin.version>
        <!-- Default native image target; override with -P native-linux-x64 etc. -->
        <native.image.name>boxy</native.image.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>mvsm</groupId>
            <artifactId>boxy-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>mvsm</groupId>
            <artifactId>boxy-mysql</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Schema migrations for boxy db init / boxy db migrate -->
        <dependency>
            <groupId>mvsm</groupId>
            <artifactId>boxy-db</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- Liquibase (schema management) -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- CLI argument parsing — GraalVM native-image friendly -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <!-- picocli annotation processor generates GraalVM reflect-config at compile time -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-codegen</artifactId>
            <version>${picocli.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- LOGGING -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Enable picocli annotation processor for native-image compatibility -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>info.picocli</groupId>
                            <artifactId>picocli-codegen</artifactId>
                            <version>${picocli.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Aproject=${project.groupId}/${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Shade plugin: produce a fat jar for JVM execution -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>boxy.cli.Boxy</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Native image profiles — one per target platform.
          Usage: mvn package -P native-macos-arm64
          Requires: GraalVM JDK 25 with native-image installed (gu install native-image).
        -->
        <profile>
            <id>native-macos-arm64</id>
            <activation>
                <!-- Default active profile for macOS ARM; override via -P flag -->
                <os>
                    <name>Mac OS X</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.native.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${native.image.name}</imageName>
                            <mainClass>boxy.cli.Boxy</mainClass>
                            <buildArgs>
                                <arg>--no-fallback</arg>
                                <arg>-H:+ReportExceptionStackTraces</arg>
                                <arg>--initialize-at-build-time=org.slf4j</arg>
                                <arg>-H:ConfigurationFileDirectories=${project.basedir}/src/main/resources/META-INF/native-image</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-macos-x64</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.native.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${native.image.name}</imageName>
                            <mainClass>boxy.cli.Boxy</mainClass>
                            <buildArgs>
                                <arg>--no-fallback</arg>
                                <arg>-H:+ReportExceptionStackTraces</arg>
                                <arg>--initialize-at-build-time=org.slf4j</arg>
                                <arg>-H:ConfigurationFileDirectories=${project.basedir}/src/main/resources/META-INF/native-image</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-linux-arm64</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.native.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${native.image.name}</imageName>
                            <mainClass>boxy.cli.Boxy</mainClass>
                            <buildArgs>
                                <arg>--no-fallback</arg>
                                <arg>-H:+ReportExceptionStackTraces</arg>
                                <arg>--initialize-at-build-time=org.slf4j</arg>
                                <arg>-H:ConfigurationFileDirectories=${project.basedir}/src/main/resources/META-INF/native-image</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-linux-x64</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.native.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${native.image.name}</imageName>
                            <mainClass>boxy.cli.Boxy</mainClass>
                            <buildArgs>
                                <arg>--no-fallback</arg>
                                <arg>-H:+ReportExceptionStackTraces</arg>
                                <arg>--initialize-at-build-time=org.slf4j</arg>
                                <arg>-H:ConfigurationFileDirectories=${project.basedir}/src/main/resources/META-INF/native-image</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-windows-x64</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${graalvm.native.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>${native.image.name}</imageName>
                            <mainClass>boxy.cli.Boxy</mainClass>
                            <buildArgs>
                                <arg>--no-fallback</arg>
                                <arg>-H:+ReportExceptionStackTraces</arg>
                                <arg>--initialize-at-build-time=org.slf4j</arg>
                                <arg>-H:ConfigurationFileDirectories=${project.basedir}/src/main/resources/META-INF/native-image</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
