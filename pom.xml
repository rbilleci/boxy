<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>mvsm</groupId>
    <artifactId>boxy</artifactId>
    <version>1.0-SNAPSHOT</version>

    <packaging>pom</packaging>
    <name>Boxy Event Queue</name>
    <description>Boxy: MySQL-based distributed event queue with Pulsar-like semantics. Supports at-least-once delivery, consumer groups with round-robin partition lease balancing, and configurable cursor management.</description>
    <url>https://github.com/rbilleci/boxy</url>
    
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>rbilleci</id>
            <name>Ray Billeci</name>
            <email>ray.billeci@gmail.com</email>
            <roles>
                <role>architect</role>
                <role>lead developer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/rbilleci/boxy.git</connection>
        <developerConnection>scm:git:https://github.com/rbilleci/boxy.git</developerConnection>
        <url>https://github.com/rbilleci/boxy</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>boxy-core</module>
        <module>boxy-test</module>
        <module>boxy-cli</module>
        <module>boxy-db</module>
    </modules>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Compiler: targets JDK 25 with release flag -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>25</release>
                        <!--
                          Uncomment to enable JDK 25 preview features (e.g. structured
                          concurrency, string templates if still in preview).
                          Also uncomment the matching argLine entry in surefire below.
                        -->
                        <!-- <compilerArgs><arg>- -enable-preview</arg></compilerArgs> -->
                    </configuration>
                </plugin>

                <!--
                  Surefire 3.5.3: confirmed compatible with JDK 25.
                  Integration tests live under src/test/java/boxy/core/it/ and follow
                  the *IT naming convention; they require Docker for Testcontainers.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                    <configuration>
                        <includes>
                            <include>**/it/**/*IT.java</include>
                        </includes>
                        <!--
                          JVM args for JDK 25: open reflective access packages required by
                          HikariCP, Testcontainers, and Liquibase. Extend as needed.
                          If preview features are enabled in the compiler plugin, also add:
                            <arg>- -enable-preview</arg>
                        -->
                        <argLine>
                            --add-opens java.base/java.lang=ALL-UNNAMED
                            --add-opens java.base/java.util=ALL-UNNAMED
                            --add-opens java.base/java.nio=ALL-UNNAMED
                        </argLine>
                    </configuration>
                </plugin>

                <!-- Javadoc: generate API docs with JDK 25 javadoc tool -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                    <configuration>
                        <release>25</release>
                        <quiet>true</quiet>
                        <failOnError>true</failOnError>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Sources: attach source jars for IDE and repository publishing -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- GPG Signing: required for Maven Central publishing (Section 12, item 109) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.7</version>
                    <executions>
                        <execution>
                            <id>sign-artifacts</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>sign</goal>
                            </goals>
                            <configuration>
                                <!-- Use gpg2 if available -->
                                <gpgArguments>
                                    <arg>--pinentry-mode</arg>
                                    <arg>loopback</arg>
                                </gpgArguments>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  JaCoCo: code coverage reporting with minimum threshold enforcement.
                  Section 1, item 69.

                  Usage:
                    mvn verify                       # runs tests + coverage check
                    mvn jacoco:report                # generate HTML report in target/site/jacoco/

                  Coverage thresholds (enforced during `mvn verify`):
                    - Line coverage  ≥ 60%
                    - Branch coverage ≥ 50%

                  To view the report: open target/site/jacoco/index.html in a browser.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.13</version>
                    <executions>
                        <!-- Attach the JaCoCo agent before tests run -->
                        <execution>
                            <id>jacoco-prepare</id>
                            <goals><goal>prepare-agent</goal></goals>
                        </execution>
                        <!-- Generate HTML/XML report after tests -->
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals><goal>report</goal></goals>
                        </execution>
                        <!-- Enforce minimum coverage thresholds -->
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals><goal>check</goal></goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <!-- Line coverage ≥ 60% -->
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.60</minimum>
                                            </limit>
                                            <!-- Branch coverage ≥ 50% -->
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.50</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                                <!-- Exclude generated code and test infrastructure from coverage -->
                                <excludes>
                                    <exclude>boxy/cli/**</exclude>
                                    <exclude>boxy/core/it/**</exclude>
                                </excludes>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  Maven Release Plugin: automates version bumping, tagging, and publishing.
                  Section 12, item 111.

                  Configure before first release:
                    1. Set distributionManagement in this POM (GitHub Packages or Maven Central).
                    2. Add scm section with Git URLs.
                    3. Run: mvn release:prepare release:perform

                  Currently configured for GitHub Packages. For Maven Central, replace the
                  repository URL with the OSSRH staging URL and add nexus-staging-maven-plugin.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.1.1</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <!-- Use -DskipTests=false to run tests during release -->
                        <releaseProfiles>release</releaseProfiles>
                        <goals>deploy</goals>
                    </configuration>
                </plugin>

                <!--
                  Nexus Staging Maven Plugin: for Maven Central publishing via OSSRH.
                  Activated in the 'release' profile.
                -->
                <plugin>
                    <groupId>org.sonatype.plugins</groupId>
                    <artifactId>nexus-staging-maven-plugin</artifactId>
                    <version>1.7.0</version>
                    <extensions>true</extensions>
                    <configuration>
                        <serverId>ossrh</serverId>
                        <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                        <autoReleaseAfterClose>true</autoReleaseAfterClose>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!--
      Distribution Management: GitHub Packages as default (Section 12, item 109).
      To publish: mvn deploy -DskipTests
      Requires GITHUB_TOKEN with write:packages permission.
      Set in ~/.m2/settings.xml:
        <server>
          <id>github</id>
          <username>YOUR_GITHUB_USERNAME</username>
          <password>${env.GITHUB_TOKEN}</password>
        </server>

      For Maven Central: use the 'release' profile (see profiles section below).
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — boxy</name>
            <url>https://maven.pkg.github.com/rbilleci/boxy</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages — boxy (snapshots)</name>
            <url>https://maven.pkg.github.com/rbilleci/boxy</url>
        </snapshotRepository>
    </distributionManagement>

    <dependencyManagement>
        <dependencies>

            <!-- LIQUIBASE FOR SCHEMA MANAGEMENT -->
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>4.32.0</version>
            </dependency>

            <!-- CLI ARGUMENT PARSING (GraalVM native-image friendly) -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>4.7.6</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-codegen</artifactId>
                <version>4.7.6</version>
            </dependency>

            <!-- RUNTIME METRICS -->
            <dependency>
                <groupId>org.hdrhistogram</groupId>
                <artifactId>HdrHistogram</artifactId>
                <version>2.2.2</version>
            </dependency>

            <!-- OBSERVABILITY: Micrometer core metrics abstraction (items #80-#86) -->
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-core</artifactId>
                <version>1.14.5</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>micrometer-registry-prometheus</artifactId>
                <version>1.14.5</version>
            </dependency>

            <!-- Janino for conditional logback config (BOXY_LOG_FORMAT selection) -->
            <dependency>
                <groupId>org.codehaus.janino</groupId>
                <artifactId>janino</artifactId>
                <version>3.1.12</version>
            </dependency>

            <!-- LOGGING DEPENDENCIES -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.17</version>
            </dependency>

            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>1.5.18</version>
            </dependency>

            <!-- DATABASE CONNECTION POOLING -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>6.3.0</version>
            </dependency>


            <!-- DATABASE DRIVERS (MYSQL) -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.4.0</version>
            </dependency>

            <!-- TESTING -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <!-- 3.27.5: updated ByteBuddy dependency for JDK 25 compatibility -->
                <version>3.27.5</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>5.13.1</version>
                <scope>test</scope>
            </dependency>

            <!-- TEST CONTAINERS -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mysql</artifactId>
                <!-- 1.21.4: fixes JDK 23+ (and JDK 25) compatibility issues -->
                <version>1.21.4</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>1.21.4</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!--
      =========================================================================
      Profiles: Release, Benchmarking
      =========================================================================

      'release' profile: Activated during release:perform to sign artifacts,
                        publish to Maven Central via OSSRH, and create GitHub
                        releases. Requires GPG key configured and Maven settings
                        with OSSRH credentials.

      'bench-*' profiles: Three hardware tiers for benchmarking.
    -->

    <profiles>

        <!--
          release — Maven Central + GitHub Releases (Section 12, items 109-111).
          Activated during release:perform. Requires:
            1. ~/.m2/settings.xml with OSSRH server credentials:
                 <server>
                   <id>ossrh</id>
                   <username>JIRA_USERNAME</username>
                   <password>JIRA_PASSWORD</password>
                 </server>
            2. GPG key configured locally (run 'gpg --list-keys' to verify)
            3. GitHub token for releasing to GitHub Releases (via gh CLI)

          Usage:
            mvn release:prepare release:perform
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.plugins</groupId>
                        <artifactId>nexus-staging-maven-plugin</artifactId>
                        <version>1.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <serverId>ossrh</serverId>
                            <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                            <autoReleaseAfterClose>true</autoReleaseAfterClose>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
            <distributionManagement>
                <repository>
                    <id>ossrh</id>
                    <name>OSSRH Releases</name>
                    <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
                </repository>
                <snapshotRepository>
                    <id>ossrh</id>
                    <name>OSSRH Snapshots</name>
                    <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>

        <!--
          bench-local — Testcontainers + tmpfs, relaxed durability.
          Runs BenchmarkIT and PipelineBenchmarkIT.
          All other *IT tests are excluded to keep the run focused.
        -->
        <profile>
            <id>bench-local</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <includes>
                                    <include>**/it/BenchmarkIT.java</include>
                                    <include>**/it/PipelineBenchmarkIT.java</include>
                                </includes>
                                <argLine>
                                    --add-opens java.base/java.lang=ALL-UNNAMED
                                    --add-opens java.base/java.util=ALL-UNNAMED
                                    --add-opens java.base/java.nio=ALL-UNNAMED
                                </argLine>
                                <systemPropertyVariables>
                                    <!-- Signals benchmarks they are running in local/CI mode -->
                                    <boxy.bench.profile>local</boxy.bench.profile>
                                </systemPropertyVariables>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>

        <!--
          bench-cloud-small — external MySQL on db.r6g.large / gp3.
          Skips Testcontainers; connection provided via environment variables.
          Hardware spec:  2 vCPU, 16 GB RAM, gp3 3000 IOPS
          MySQL tuning:   innodb_flush_log_at_trx_commit=1 (full durability)
        -->
        <profile>
            <id>bench-cloud-small</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <includes>
                                    <include>**/it/BenchmarkIT.java</include>
                                    <include>**/it/PipelineBenchmarkIT.java</include>
                                </includes>
                                <argLine>
                                    --add-opens java.base/java.lang=ALL-UNNAMED
                                    --add-opens java.base/java.util=ALL-UNNAMED
                                    --add-opens java.base/java.nio=ALL-UNNAMED
                                </argLine>
                                <systemPropertyVariables>
                                    <boxy.bench.profile>cloud-small</boxy.bench.profile>
                                    <!-- Connection details from environment (set before running) -->
                                    <DB_TYPE>mysql</DB_TYPE>
                                </systemPropertyVariables>
                                <environmentVariables>
                                    <!-- Inherit DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD
                                         from the shell environment. -->
                                </environmentVariables>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>

        <!--
          bench-cloud-prod — external MySQL on db.r6g.2xlarge+ / io2 (target: 1M events/sec).
          Hardware spec:  ≥8 vCPU, ≥64 GB RAM, io2 ≥64K IOPS
          MySQL tuning:   innodb_flush_log_at_trx_commit=2, sync_binlog=0
        -->
        <profile>
            <id>bench-cloud-prod</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <includes>
                                    <include>**/it/BenchmarkIT.java</include>
                                    <include>**/it/PipelineBenchmarkIT.java</include>
                                </includes>
                                <argLine>
                                    --add-opens java.base/java.lang=ALL-UNNAMED
                                    --add-opens java.base/java.util=ALL-UNNAMED
                                    --add-opens java.base/java.nio=ALL-UNNAMED
                                </argLine>
                                <systemPropertyVariables>
                                    <boxy.bench.profile>cloud-prod</boxy.bench.profile>
                                    <DB_TYPE>mysql</DB_TYPE>
                                </systemPropertyVariables>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>

    </profiles>

</project>
